# ==============================================================================
# 🏢 MBI INVENTRA — ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# 1. Node & Network Settings
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 2. Live Application Domain
APP_URL=https://mbiinventra.com
DOMAIN_NAME=https://mbiinventra.com

# 3. Master Panel & Admin Authentication
JWT_SECRET=your_super_strong_jwt_secret_key_here
MASTER_PASSWORD=your_master_admin_password
MASTER_PANEL_PIN=your_master_panel_pin
EMERGENCY_RECOVERY_KEY=your_emergency_recovery_key

# 4. SQLite Vault Storage Configuration (Tenant-Isolated Database Engine)
SQLITE_VAULT_DIR=server/data/tenants
SQLITE_MASTER_VAULT=server/data/master/master_hub.sqlite

# 5. Meta WhatsApp Cloud API Gateway
WHATSAPP_PHONE_NUMBER=03XXXXXXXXX
WHATSAPP_API_KEY=your_meta_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 6. Google Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key
