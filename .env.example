# ==============================================================================
# 🏢 MBI INVENTRA — PRODUCTION ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. Server & Network Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# 2. Live Application Domain (Replace with your live domain)
APP_URL=https://mbiinventra.com
DOMAIN_NAME=https://mbiinventra.com

# 3. Master Panel & Admin Authentication
JWT_SECRET=mbi_inventra_ultra_secure_jwt_secret_key_2026_x98f2
MASTER_USERNAME=admin
MASTER_PASSWORD=your_master_admin_password
MASTER_PANEL_PIN=1234
EMERGENCY_RECOVERY_KEY=MBI-EMERGENCY-2026-RECOVERY-KEY

# 4. 🔒 PERSISTENT SQLITE VAULT STORAGE (IMPORTANT FOR ZERO DATA LOSS ON GIT DEPLOY)
# Set DATA_DIR to a directory OUTSIDE your git repo so git pull/deploy never wipes your data!
# Linux / VPS Example: DATA_DIR=/var/mbi_inventra_data
# Windows Server Example: DATA_DIR=C:/mbi_persistent_vault
# If left commented, it will default to server/data with auto-backup to ../mbi_server_vault_persistent
DATA_DIR=

# 5. Meta WhatsApp Cloud API (Optional - for direct WhatsApp messaging)
WHATSAPP_PHONE_NUMBER=03XXXXXXXXX
WHATSAPP_API_KEY=your_meta_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id

# 6. Official Google Gemini AI (Recommended for MBI AI Assistant)
GEMINI_API_KEY=your_google_gemini_api_key

